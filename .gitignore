# Environnements virtuels
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Poids de modèles. yolov8n.pt se retélécharge tout seul chez Ultralytics ;
# les poids d'entraînement intermédiaires restent locaux.
models/*.pt
models/*.onnx
models/finetuned/*

# Exception : les poids fine-tunés sont le livrable du projet et la seule
# chose non régénérable sans relancer un entraînement complet. 6 Mo, requis
# par l'application Streamlit une fois déployée.
!models/finetuned/yolov8n_benin.pt

# Jeu de données téléchargé et sa conversion.
# Plusieurs giga-octets, entièrement régénérables : le jeu se retélécharge et
# l'import se rejoue à partir de configs/import.yaml, qui lui est versionné.
data/raw/
data/dataset/
data/outputs/

# Sorties d'entraînement et d'évaluation.
# results/comparaison.* est le livrable du rapport : on le garde.
results/entrainements/*
runs/
*.cache

# Exception : le run du fine-tuning documenté dans l'article. results.csv
# est la source de figures/courbes_entrainement.pdf (scripts/tracer_courbes.py)
# et args.yaml atteste des hyperparamètres réellement utilisés ; sans eux la
# figure n'est plus régénérable après la fermeture de la session Colab.
# Les poids restent exclus : best.pt est déjà versionné sous
# models/finetuned/yolov8n_benin.pt, last.pt n'a pas d'intérêt.
!results/entrainements/yolov8n_benin/
results/entrainements/yolov8n_benin/weights/

# Vues temporaires créées par scripts/evaluate.py
_vue_coco_*

# Système
.DS_Store
Thumbs.db
desktop.ini

# Fichiers temporaires bureautiques
~$*

# Claude
.claude/
# Documents de travail non versionnés
docs/PROMPTS_CLAUDE.md
docs/PLAN_SOUTENANCE.md
